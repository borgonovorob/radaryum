{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "radaryum",
  "main": "src/index.js",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/companies",
      "/company/*",
      "/latest",
      "/trending",
      "/countries",
      "/country/*",
      "/industries",
      "/industry/*",
      "/signals",
      "/signals/*",
      "/sitemap.xml"
    ]
  },
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "vars": {
    "RADARYUM_VERSION": "6.3.1-clarity"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radaryum-db",
      "database_id": "4dbfea16-5357-4647-ab71-802cc9aef9c2"
    }
  ]
}
